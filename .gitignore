# The IBTrACS CSVs are huge (~50–110 MB each) and re-downloaded fresh by
# the GitHub Action on every run, so we don't need to check them in.
ibtracs.WP.list.v04r01.csv
ibtracs.NA.list.v04r01.csv
ibtracs.EP.list.v04r01.csv

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor / OS
.DS_Store
.idea/
.vscode/

# MP4 animation pipeline. Frames are cached between CI runs (R2 tar);
# the build dir is staged and synced to R2 (the orphan `mp4-artifacts`
# branch is retired) — neither belongs on main.
_frame_cache/
_mp4_build/

# ----------------------------------------------------------------------
# R2 phase 1: workflow-generated media + large static files now live on
# cdn.triple-a-tropics.com (Cloudflare R2). The scheduled workflows
# upload here on every cron run; the live site fetches cross-origin.
# Listed paths are no longer tracked in git.
# ----------------------------------------------------------------------
sst/*.png
subsurface/*.png
armor3d/*.png
# SST climatology: per-region curve data (SVG hydration) + the standalone
# anomaly inset are build output synced to cdn.triple-a-tropics.com/sst/ by
# update-sst.yml. The tracked index is sst/climatology_manifest.json (does NOT
# match *_climatology.json), so it stays committed.
sst/*_climatology.json
.sst_cache/
gibs/*.jpg
gibs/manifest.json
# Observed passive-microwave (TC-PRIMED): PNG + JSON rendered each run and
# synced to cdn.triple-a-tropics.com/microwave/ by update-tcprimed.yml; the
# viewer (microwave/index.html, microwave/microwave.js, both tracked) reads
# them cross-origin. Nothing here is committed.
tcprimed_build/
# HAFS model plots: PNG frames + manifest are rendered each cycle and synced
# to cdn.triple-a-tropics.com/models/hafs/ by update-hafs.yml — the frontend
# (models/index.html, models/hafs.js, both tracked) reads them cross-origin.
# Only the rendered output under models/hafs/ is ignored, not the page.
models/hafs/
# Ensemble Cyclone Centers: per-cycle detection JSON + manifest are built each
# cycle and synced to cdn.triple-a-tropics.com/models/enscenters/ by
# update-enscenters.yml. The frontend (models/index.html, models/enscenters.js,
# both tracked) reads them cross-origin. Only the built output is ignored.
models/enscenters/
# Dev artifact from the standalone single-frame slice (python hafs_plot.py).
hafs_test.png
# Local scratch renders used to eyeball palettes/masking before a full cycle.
hafs_samples/
*_season.gif
historical/*/gifs/*.gif
global_storms.geojson
Climatology-page.jpg
sst-page.jpg
Satoshiplot.jpg

# SST climatology curves: the per-region daily-mean cache is a build
# INPUT rewritten daily (computed by generate_sst_climatology.py, staged
# here, served from cdn.triple-a-tropics.com/sst/sst_region_daily_means.npz).
# Like armor3d_climatology.nc it lives on R2, not in git.
_sst_clim_build/

# R2 phase 2: the ~56 MiB ARMOR3D climatology is a build INPUT (read by
# generate_armor3d_plots.py for anomaly overlays), not a browser asset.
# build-armor3d-climatology.yml uploads it to R2; update-armor3d.yml
# fetches it from cdn.triple-a-tropics.com before rendering.
armor3d/armor3d_climatology.nc

# Archive feed base (Piece 3): built by build_feed_base.py, R2-only (poller reads it from the CDN)
feeds/base/

# CRW day-of-year SST bakes (CycloLab per-storm page). Both are R2-only
# build outputs, never committed:
#   build_crw_doy_climatology.py → sst/climo/   (366 DOY 1991-2020 mean grids)
#   bake_crw_doy_records.py      → sst/records/ (per-pixel daily record-max)
# The local state dirs hold per-DOY .nc checkpoints + memmap accumulators.
_crw_doy_climo_state/
_crw_doy_record_state/

# ARMOR3D TCHP per-WOY record envelope (~118 MiB) + bake state: R2-only —
# baked by bake_armor3d_tchp_records.py, fetched from R2 by update-armor3d.yml
# as a build input (like armor3d_climatology.nc). Never committed.
sst/records/
.armor3d_records_state/

# Third-party reference / local scratch dirs - keep on disk, never track/push (not public)
_reference/
_push/
_debug/
node_modules/
package-lock.json
.claude/

# recon ingest output (R2-only, like models/enscenters)
recon_build/

# subseasonal render output (published to R2, never committed)
subseasonal/out/

# wrangler local-dev state + secrets (never commit)
workers/.dev.vars
workers/.wrangler/

# TC records engine — computed output (published to R2, never committed) +
# the HURDAT2 download cache
records_out/
records_cache/

# Models build spec lives OUT of repo at /workspaces/ (competitor observations - never public)
models_page_build_spec*.md
build_order*.csv
tc_product_catalog*.csv
